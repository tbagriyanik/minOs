{
    "CodeGPT.apiKey": "CodeGPT Plus Beta",

    "rust-analyzer.cargo.target": "x86_64-minos.json",
    "rust-analyzer.check.command": "check",
    "rust-analyzer.cargo.buildScripts.enable": true,
    "rust-analyzer.cargo.allFeatures": true,
    "rust-analyzer.cargo.extraEnv": {
        "RUSTFLAGS": "-Zjson-target-spec"
    },
    "rust-analyzer.check.extraEnv": {
        "RUSTFLAGS": "-Zjson-target-spec"
    },
    "rust-analyzer.cargo.unsetEnv": ["RUSTC_WRAPPER"],

    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.rustfmt.imports.granularity": "Crate",
        "editor.rustfmt.imports.groupImports": "StdExternalCrate"
    }
}
